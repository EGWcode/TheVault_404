option_settings:
  aws:elasticbeanstalk:application:environment:
    DB_NAME: postgres
    DB_PORT: 5432
    DB_SSLMODE: require
    AWS_S3_BUCKET: thevaultmarketplace
    AWS_REGION: us-east-2
# DB_HOST, DB_USER, DB_PASSWORD and SECRET_KEY are set in the
# Elastic Beanstalk console (Configuration > Environment properties),
# not in this file. - Tykeara Hammond
