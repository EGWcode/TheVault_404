# Copy this file to .env (in the project folder, next to app.py) and fill in your own values. - Tykeara Hammond
# The installer (install.command / install.bat) makes .env for you.
# Leave AWS_S3_BUCKET empty to save uploaded images in static/uploads/ instead of S3.
FLASK_ENV=development
SECRET_KEY=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thevault
DB_USER=postgres
DB_PASSWORD=your-local-password
DB_SSLMODE=
DATABASE_URL=postgresql://username:password@host:5432/dbname
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=
# Payments (Anthony Jackson 11/11/26): checkout is "pay the seller in person" by default.
# Optional: a Stripe TEST key (sk_test_...) adds a test-card option. Live keys (sk_live_) are refused.
STRIPE_SECRET_KEY=
